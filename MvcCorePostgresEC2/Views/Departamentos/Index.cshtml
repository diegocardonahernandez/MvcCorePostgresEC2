@model IEnumerable<MvcCorePostgresEC2.Models.Departamento>

@{
    ViewData["Title"] = "Departamentos";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-light text-dark">Listado de Departamentos</h2>
        <a asp-action="Create" class="btn btn-dark rounded-pill px-4 shadow-lg">
            + Crear Nuevo
        </a>
    </div>

    <div class="card bg-dark text-white border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="border-secondary">
                    <tr>
                        <th class="py-3 px-4 text-secondary fw-semibold">Número</th>
                        <th class="py-3 px-4 text-secondary fw-semibold">Nombre</th>
                        <th class="py-3 px-4 text-secondary fw-semibold">Localidad</th>
                        <th class="py-3 px-4 text-end text-secondary fw-semibold">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="py-3 px-4 text-light">@item.DeptNo</td>
                                <td class="py-3 px-4 fw-medium text-white">@item.Nombre</td>
                                <td class="py-3 px-4 text-light">@item.Loc</td>
                                <td class="py-3 px-4 text-end">
                                    <a asp-action="Details" asp-route-id="@item.DeptNo" 
                                       class="btn btn-sm btn-outline-light rounded-pill px-3">
                                        Ver detalles
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-secondary">
                                No se encontraron departamentos registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
